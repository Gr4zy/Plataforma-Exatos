<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Plataforma Exatos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
</head>
<body>

    <nav class="navbar navbar-dark bg-custom-sidebar d-lg-none sticky-top shadow-sm px-3">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" href="/">
                <img src="/images/LOGO.png" alt="Plataforma Exatos" class="logo-img-mobile">
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menuMobile" aria-controls="menuMobile" aria-expanded="false" aria-label="Toggle navigation">
                <span class="material-symbols-outlined text-white fs-1">menu</span>
            </button>

            <div class="collapse navbar-collapse mt-3" id="menuMobile">
                <div class="nav flex-column gap-2 pb-2">
                    <a href="/" id="btn-inicio-mobile" class="nav-link menu-item text-white rounded-3 d-flex align-items-center gap-2 p-2 fs-5">
                        <span class="material-symbols-outlined">view_cozy</span>
                        Início
                    </a>
                    <a href="/classes" id="btn-videoaulas-mobile" class="nav-link menu-item text-white rounded-3 d-flex align-items-center gap-2 p-2 fs-5">
                        <span class="material-symbols-outlined">play_arrow</span>
                        Videoaulas
                    </a>
                    <a href="/admin/aulas" id="btn-admin-aulas-mobile" class="nav-link menu-item text-white rounded-3 d-flex align-items-center gap-2 p-2 fs-5">
                        <span class="material-symbols-outlined">add_box</span>
                        Cadastrar Aula
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <aside class="col-lg-2 bg-custom-sidebar text-white min-vh-100 p-3 d-none d-lg-block position-sticky top-0 h-100">
                <div class="logo-area text-center py-3 mb-4">
                    <img src="/images/LOGO.png" alt="Plataforma Exatos" class="logo-img img-fluid">
                </div>

                <nav class="nav flex-column gap-2">
                    <a href="/" id="btn-inicio" class="nav-link menu-item text-white rounded-3 d-flex align-items-center gap-2 p-2">
                        <span class="material-symbols-outlined">view_cozy</span>
                        Início
                    </a>
                    <a href="/classes" id="btn-videoaulas" class="nav-link menu-item text-white rounded-3 d-flex align-items-center gap-2 p-2">
                        <span class="material-symbols-outlined">play_arrow</span>
                        Videoaulas
                    </a>
                    <a href="/admin/aulas" id="btn-admin-aulas" class="nav-link menu-item text-white rounded-3 d-flex align-items-center gap-2 p-2">
                        <span class="material-symbols-outlined">add_box</span>
                        Cadastrar Aula
                    </a>
                </nav>
            </aside>

            <main class="col-10 col-md-12 col-lg-10 p-4 p-md-5 mx-auto">
                {{{body}}}
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Marca o item de menu (desktop e mobile) referente à página atual.
        // Fica aqui porque o menu agora é único, compartilhado por todas as telas via layout.hbs.
        (function () {
            const pathAtual = window.location.pathname;
            const mapaAtivos = {
                '/': ['btn-inicio', 'btn-inicio-mobile'],
                '/classes': ['btn-videoaulas', 'btn-videoaulas-mobile'],
                '/admin/aulas': ['btn-admin-aulas', 'btn-admin-aulas-mobile']
            };
            const idsAtivos = mapaAtivos[pathAtual] || mapaAtivos['/'];
            idsAtivos.forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.classList.add('active');
            });
        })();
    </script>
</body>
</html>
