<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}} - Plataforma Exatos</title>
    {{> head_libs}}
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

    {{> mobile_nav}}

    <div class="container-fluid">
        <div class="row">
            {{> sidebar}}

            <main class="col-10 col-md-12 col-lg-10 p-4 p-md-5 mx-auto">
                {{{body}}}
            </main>
        </div>
    </div>

    <script>
        // Marca o item de menu (desktop e mobile) referente à página atual.
        // Fica aqui porque o menu agora é único, compartilhado por todas as telas via layout.hbs.
        (function () {
            const pathAtual = window.location.pathname;
            const mapaAtivos = {
                '/': ['btn-inicio', 'btn-inicio-mobile'],
                '/classes': ['btn-videoaulas', 'btn-videoaulas-mobile'],
                '/admin/aulas': ['btn-admin-aulas', 'btn-admin-aulas-mobile'],
                '/admin/quizzes': ['btn-admin-quizzes', 'btn-admin-quizzes-mobile']
            };
            const idsAtivos = mapaAtivos[pathAtual] || mapaAtivos['/'];
            idsAtivos.forEach(function (id) {
                const el = document.getElementById(id);
                if (el) el.classList.add('active');
            });
        })();
    </script>
</body>
</html>
