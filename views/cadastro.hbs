<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - Plataforma Exatos</title>

    {{> auth_head}}
</head>

<body>

<div class="container">

    <div class="left" onclick="window.location.href='/inicio'" style="cursor: pointer;">

        <img src="/images/LOGO.png" class="logo">

        <h1>
            Crie sua conta<br>
            e comece a estudar<br>
            com a Plataforma Exatos
        </h1>

        <p>
            Cadastre-se gratuitamente e tenha acesso às videoaulas,
            materiais didáticos, quizzes e muito mais.
        </p>

    </div>

    <div class="right">

        <div class="login-box">

            <h2>Criar Conta</h2>

            <span>Preencha os dados abaixo</span>

            {{#if erro}}
            <div class="alert-erro" style="background:#fdecea;color:#611a15;border:1px solid #f5c2c0;border-radius:8px;padding:10px 14px;margin-top:14px;font-size:0.9rem;">
                {{erro}}
            </div>
            {{/if}}

            <form action="/cadastro" method="POST">

                <label>Nome</label>

                <div class="input-box">
                    <i class="fa-regular fa-user"></i>
                    <input type="text" name="nome" value="{{nome}}" required>
                </div>

                <label>E-mail</label>

                <div class="input-box">
                    <i class="fa-regular fa-envelope"></i>
                    <input type="email" name="email" value="{{email}}" required>
                </div>

                <label>Senha</label>

                <div class="input-box">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" id="senha" name="senha" required>
                    <i class="fa-regular fa-eye" id="mostrarSenha"></i>
                </div>

                <button type="submit">
                    Cadastrar
                </button>

                <p style="text-align:center; margin-top:20px;">
                    Já possui uma conta?
                    <a href="/login">Entrar</a>
                </p>

            </form>

        </div>

    </div>

</div>

{{> toggle_senha_script}}

</body>
</html>