<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Plataforma Exatos</title>

    {{> auth_head}}
</head>

<body>

    <div class="container">

        <div class="left" onclick="window.location.href='/inicio'" style="cursor: pointer;">

            <img src="/images/LOGO.png" class="logo">

            <span class="bemvindo">
                BEM-VINDO À
            </span>

            <h1>
                Sua plataforma<br>
                de estudos para<br>
                o ENEM e o IFRN
            </h1>

            <p>
                Videoaulas, materiais didáticos, quizzes e ranking
                para você se preparar com excelência.
            </p>

        </div>

        <div class="right">

            <div class="login-box">

                <h2>Entrar na plataforma</h2>

                <span>PIBID com você no ENEM e no IFRN</span>

                {{#if erro}}
                <div class="alert-erro" style="background:#fdecea;color:#611a15;border:1px solid #f5c2c0;border-radius:8px;padding:10px 14px;margin-top:14px;font-size:0.9rem;">
                    {{erro}}
                </div>
                {{/if}}

                <form action="/login" method="POST">
                    <label>E-mail</label>

                    <div class="input-box">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="email" name="email" required>
                    </div>

                    <label>Senha</label>
                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="senha" name="senha" required>
                        <i class="fa-regular fa-eye" id="mostrarSenha"></i>
                    </div>

                    <button type="submit">
                        Entrar
                    </button>

                    <p style="text-align:center; margin-top:20px;">
                        Não possui conta?
                        <a href="/cadastro">Cadastre-se</a>
                    </p>


                </form>

            </div>

        </div>

    </div>
    {{> toggle_senha_script}}
</body>

</html>