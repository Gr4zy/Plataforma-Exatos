PORT=3000
SESSION_SECRET=troque-este-segredo-em-producao

# Banco de dados
# Padrão: SQLite (não exige instalar nada, ótimo para desenvolvimento)
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Para usar MySQL/Postgres na infraestrutura do IFRN (RNF07), troque
# DB_DIALECT para 'mysql' ou 'postgres' e preencha as linhas abaixo:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=plataforma_exatos
# DB_USER=usuario_do_banco
# DB_PASSWORD=senha_do_banco

# Mostrar as queries SQL geradas pelo Sequelize no console (debug)
DB_LOGGING=false
